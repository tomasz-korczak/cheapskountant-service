{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/schemas/fiscal-receipt.schema.json",
    "title": "Polski paragon fiskalny",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "documentType",
      "seller",
      "receipt",
      "items",
      "taxSummary",
      "totals",
      "payments"
    ],
    "properties": {
      "documentType": {
        "const": "fiscal_receipt"
      },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fileName": { "type": "string" },
          "rawText": { "type": "string" }
        }
      },
      "seller": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tradeName", "taxId"],
        "properties": {
          "tradeName": { "type": "string" },
          "legalName": { "type": "string" },
          "taxId": {
            "type": "string",
            "pattern": "^[0-9]{10}$"
          },
          "bdoNumber": {
            "type": "string",
            "pattern": "^[0-9]{9}$"
          },
          "businessAddress": { "$ref": "#/$defs/address" },
          "registeredAddress": { "$ref": "#/$defs/address" }
        }
      },
      "receipt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "issuedAt", "currency"],
        "properties": {
          "number": { "type": "string" },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "orderNumber": { "type": "string" }
        }
      },
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "description",
            "quantity",
            "unitPrice",
            "total",
            "taxCategory",
            "category"
          ],
          "properties": {
            "description": { "type": "string" },
            "itemType": {
              "type": "string",
              "enum": ["product", "service", "packaging", "other"]
            },
            "quantity": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": { "type": "string" },
            "unitPrice": { "$ref": "#/$defs/money" },
            "total": { "$ref": "#/$defs/money" },
            "taxCategory": { "type": "string" },
            "category": { "type": "string", "minLength": 1 },
            "discount": { "$ref": "#/$defs/discount" }
          }
        }
      },
      "discountSummary": { "$ref": "#/$defs/discount" },
      "taxSummary": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "taxCategory",
            "taxRate",
            "taxableSales",
            "taxAmount"
          ],
          "properties": {
            "taxCategory": { "type": "string" },
            "taxRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "taxableSales": { "$ref": "#/$defs/money" },
            "taxAmount": { "$ref": "#/$defs/money" }
          }
        }
      },
      "totals": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taxAmount", "grossAmount", "amountDue"],
        "properties": {
          "taxAmount": { "$ref": "#/$defs/money" },
          "grossAmount": { "$ref": "#/$defs/money" },
          "amountDue": { "$ref": "#/$defs/money" }
        }
      },
      "payments": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "amount"],
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "cash",
                "card",
                "transfer",
                "voucher",
                "mobile",
                "other"
              ]
            },
            "amount": { "$ref": "#/$defs/money" },
            "transactionId": { "type": "string" }
          }
        }
      },
      "fiscalData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "cashRegisterCode": { "type": "string" },
          "cashierCode": { "type": "string" },
          "fiscalDeviceNumber": { "type": "string" },
          "verificationHash": { "type": "string" },
          "rawIdentificationLine": { "type": "string" }
        }
      },
      "unparsedLines": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "$defs": {
      "money": {
        "type": "string",
        "pattern": "^-?[0-9]+\\.[0-9]{2}$"
      },
      "negativeMoney": {
        "type": "string",
        "pattern": "^-(?:0*[1-9][0-9]*\\.[0-9]{2}|0\\.[0-9][1-9]|0\\.[1-9][0-9])$"
      },
      "discount": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "total"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "total": { "$ref": "#/$defs/negativeMoney" }
        }
      },
      "address": {
        "type": "object",
        "additionalProperties": false,
        "required": ["street", "postalCode", "city", "countryCode"],
        "properties": {
          "street": { "type": "string" },
          "postalCode": {
            "type": "string",
            "pattern": "^[0-9]{2}-[0-9]{3}$"
          },
          "city": { "type": "string" },
          "countryCode": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        }
      }
    }
  }